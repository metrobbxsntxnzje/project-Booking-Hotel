{
  "name": "project-booking-hotel",
  "version": "1.0.0",
  "description": "Backend base for the booking hotel project built with Express and Sequelize.",
  "main": "index.js",
  "_moduleAliases": {
    "@": "src"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --exitcrash index.js",
    "staging_prep": "npm i && cross-env NODE_ENV=staging npx sequelize-cli db:migrate",
    "staging": "cross-env NODE_ENV=staging node index.js",
    "prod": "NODE_ENV=production node index.js"
  },
  "author": "metrobbxsntxnzje",
  "dependencies": {
    "archiver": "^5.3.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-fetch": "^3.1.5",
    "dotenv": "^17.4.2",
    "dotenv-flow": "^3.2.0",
    "express": "^4.18.2",
    "express-validator": "^7.3.2",
    "fast-csv": "^4.3.6",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "nodemailer": "^6.9.2",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.3",
    "sequelize": "^6.37.8",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.59.3",
    "cross-env": "^7.0.3",
    "nodemon": "^2.0.20",
    "sequelize-cli": "^6.5.1",
    "typescript": "^6.0.3"
  }
}
